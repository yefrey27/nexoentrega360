{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexoentrega.example/contracts/ai-output.schema.json",
  "title": "Salida esperada del asistente de IA",
  "description": "Se valida junto con controles en código: requestId debe pertenecer al conjunto enviado y no repetirse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "recommendations"],
  "properties": {
    "summary": { "type": "string", "maxLength": 600 },
    "recommendations": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "reason", "evidenceFields"],
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "maxLength": 240 },
          "evidenceFields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["zona", "prioridad", "fechaRequerida", "observaciones"] }
          }
        }
      }
    }
  }
}
