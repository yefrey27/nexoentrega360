# Copie a .env (ignorado por git). Todos los valores son ficticios y solo para desarrollo local.
POSTGRES_USER=nexo_owner
POSTGRES_PASSWORD=cambie-esta-clave-local
POSTGRES_DB=nexoentrega
POSTGRES_PORT=5432
# Rol de la aplicación: sin UPDATE ni DELETE sobre audit_events
NEXO_APP_PASSWORD=cambie-esta-clave-app-local
# Proveedor de IA: live | local | replay | fixture | none (por defecto none; CI usa fixture)
AI_PROVIDER=none
AI_TIMEOUT_MS=5000
# Zona horaria de negocio
BUSINESS_TZ=America/Bogota
# API (apps/api): conexión con el rol de la aplicación (nexo_app), nunca con el propietario
DATABASE_URL=postgres://nexo_app:cambie-esta-clave-app-local@127.0.0.1:5432/nexoentrega
PORT=3000
# Solo para AI_PROVIDER=fixture: id de tests/fixtures/ai/ai-provider-fixtures.json
AI_FIXTURE=AI-VALID
